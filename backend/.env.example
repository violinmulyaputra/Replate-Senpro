DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=Replate;user=your-user;password=your-password;encrypt=true"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER="Replate.Api"
JWT_AUDIENCE="Replate.Client"
JWT_EXPIRES_MINUTES="60"
FRONTEND_URL="http://localhost:3000"
PORT="5000"
# Set all SMTP values to enable password reset emails.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-user"
# SMTP_PASSWORD="your-password"
# SMTP_FROM="no-reply@example.com"
UPLOAD_DIR="uploads"
MENU_UPLOAD_DIR="menu-uploads"
